# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# OpenAI
OPENAI_API_KEY=

# App
SECRET_KEY=
PORT=8000

# LangSmith tracing (off by default). Traces contain patient messages and
# model answers, so keep inputs/outputs hidden unless you have a data agreement.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=healthvoice-ai
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
